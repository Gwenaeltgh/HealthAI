# Vite only exposes variables prefixed with VITE_

# Enable real backend calls (set to false to force mocks)
VITE_USE_REAL_API=true

# Optional: set a full backend base URL (when empty, the app uses relative /api and Vite dev proxy)
# Example: VITE_API_BASE_URL=http://localhost:15002
VITE_API_BASE_URL=

# Vite dev server proxy target for /api (defaults to http://localhost:15002)
VITE_API_PROXY_TARGET=http://localhost:15002