# Offline profile: no network calls should be made.
# Start with: npm run dev:offline

VITE_APP_PROFILE=offline
VITE_USE_REAL_API=false

# Keep empty to avoid accidental absolute calls
VITE_API_BASE_URL=

# Proxy target is irrelevant in offline (no calls should happen),
# but keeping it avoids surprising defaults if code changes.
VITE_API_PROXY_TARGET=http://localhost:15002
