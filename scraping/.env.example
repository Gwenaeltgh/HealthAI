# =============================================================================
# Kaggle API Credentials
# =============================================================================
# Copy this file to .env and fill in your Kaggle credentials.
#
# To get your Kaggle API token:
# 1. Go to https://www.kaggle.com/settings
# 2. Scroll to the "API" section
# 3. Click "Create New Token"
# 4. Open the downloaded kaggle.json file and copy the values below
#
# Alternative: Place kaggle.json in ~/.kaggle/ (Linux/Mac) 
#              or %USERPROFILE%\.kaggle\ (Windows)
# =============================================================================

# Your Kaggle username (found in kaggle.json)
KAGGLE_USERNAME=your_kaggle_username

# Your Kaggle API key (found in kaggle.json)
KAGGLE_KEY=your_kaggle_api_key_here
